<% name ||= resource.humanize %>
<% authentication_resource ||= false %>
<% authentication_provider ||= nil %>
<% resource_path = path.clone << resource %>
<% resource_info = info %>
<% heading = authentication_resource ? 'h3' : 'h1' %>
<% action_heading = authentication_resource ? 'h4' : 'h2' %>
<% parameter_heading = authentication_resource ? 'h5' : 'h3' %>
<<%= heading %> class="resource" id="<%= escape_html("#{prefix}-#{resource}") %>"><%= escape_html(name) %></<%= heading %>>
<div class="resource-body">
  <p><%= info[:description] %></p>
  <div class="actions">
    <% sort_hash(info[:actions]).each do |action, info| %>
      <section data-doc-section id="<%= escape_html("#{prefix}-#{resource}-#{action}") %>">
        <<%= action_heading %>><%= escape_html(action.capitalize) %></<%= action_heading %>>
        <div class="action">
          <dl class="docs-metadata">
            <dt>Path</dt><dd><%= info[:method] %> <%= info[:path] %></dd>
            <dt>Description</dt><dd><%= info[:description] %></dd>
            <dt>Authentication required</dt><dd><%= info[:auth] ? 'yes' : 'no' %></dd>
            <dt>Scope</dt><dd><%= info[:scope] %></dd>
            <dt>Aliases</dt><dd><%= info[:aliases].join(', ') %></dd>
            <dt>Blocking</dt><dd><%= info[:blocking] ? 'yes' : 'no' %></dd>
          </dl>
          <<%= parameter_heading %>>Input parameters</<%= parameter_heading %>>
          <% if info[:input][:parameters].empty? %>
            <p>No parameters.</p>
          <% else %>
            <dl class="docs-metadata">
              <dt>Layout</dt><dd><%= info[:input][:layout] %></dd>
              <dt>Namespace</dt><dd><%= info[:input][:namespace] %></dd>
            </dl>
            <div class="docs-table-scroll" tabindex="0" role="region" aria-label="Input parameters">
              <table class="docs-input-parameters">
                <thead><tr><th>Parameter</th><th>Type</th><th>Required</th><th>Details</th></tr></thead>
                <tbody>
                  <% info[:input][:parameters].each do |param, parameter| %>
                    <tr id="<%= escape_html(documentation_parameter_anchor(resource_path: resource_path, action_name: action, direction: :input, parameter_name: param, authentication: authentication_provider)) %>">
                      <td class="docs-param-name"><code><%= escape_html(param) %></code><% if parameter[:label].to_s != param.to_s %><div><%= parameter[:label] %></div><% end %></td>
                      <td><%= format_param_type(parameter) %></td>
                      <td><%= parameter[:required] ? 'yes' : 'no' %></td>
                      <td class="docs-param-details">
                        <% if parameter[:description] %><p><%= escape_html(parameter[:description]) %></p><% end %>
                        <% if parameter.has_key?(:default) && parameter[:default] != :_nil %>
                          <p><strong>Default:</strong> <code><%= escape_html(parameter[:default].nil? ? 'null' : parameter[:default] == '' ? '""' : parameter[:default]) %></code></p>
                        <% end %>
                        <%= format_validators(parameter[:validators], type: parameter[:type]) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
          <<%= parameter_heading %>>Output parameters</<%= parameter_heading %>>
          <% if info[:output][:parameters].empty? && info[:output][:format].nil? %>
            <p>No parameters.</p>
          <% else %>
            <dl class="docs-metadata">
              <dt>Layout</dt><dd><%= info[:output][:layout] %></dd>
              <dt>Namespace</dt><dd><%= info[:output][:namespace] %></dd>
            </dl>
            <div class="docs-table-scroll" tabindex="0" role="region" aria-label="Output parameters">
              <table class="docs-output-parameters">
                <thead><tr><th>Parameter</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <% info[:output][:parameters].each do |param, parameter| %>
                    <tr id="<%= escape_html(documentation_parameter_anchor(resource_path: resource_path, action_name: action, direction: :output, parameter_name: param, authentication: authentication_provider)) %>">
                      <td class="docs-param-name"><code><%= escape_html(param) %></code><% if parameter[:label].to_s != param.to_s %><div><%= parameter[:label] %></div><% end %></td>
                      <td><%= format_param_type(parameter) %></td>
                      <td class="docs-param-details"><%= escape_html(parameter[:description]) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
          <% unless info[:examples].empty? %>
            <<%= parameter_heading %>>Examples</<%= parameter_heading %>>
            <p>Examples use an initialized <code>api</code> client, authenticated when required. See <a href="<%= escape_html(documentation_url(anchor: 'initialization')) %>">initialization</a> and <a href="<%= escape_html(documentation_url(page: 'authentication')) %>">authentication</a>.</p>
            <% info[:examples].each_with_index do |example, index| %>
              <h4><%= example[:title].empty? ? "Example ##{index}" : example[:title] %></h4>
              <p><%= example[:comment] %></p>
              <%= erb :'version_page/example_panels', locals: {baseid: "example-#{resource_path.join('.')}-#{action}-#{index}", kind: :example, changes: {resource_path: resource_path, resource: resource_info, action_name: action, action: info, sample: example}} %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
  <% unless info[:resources].empty? %>
    <h2>Child resources</h2>
    <% if authentication_resource %>
      <% sort_hash(info[:resources]).each do |child, child_info| %>
        <%= erb :'version_page/resource_body', locals: {resource: child, info: child_info, path: resource_path, prefix: "#{prefix}-#{resource}", name: "#{name} / #{child.humanize}", authentication_resource: true, authentication_provider: authentication_provider} %>
      <% end %>
    <% else %>
      <ul>
        <% sort_hash(info[:resources]).each do |child, child_info| %>
          <li><a href="<%= escape_html(documentation_url(resource: resource_path + [child.to_s])) %>"><%= escape_html(child.to_s.humanize) %></a></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>

require 'bundler/gem_tasks'
require 'rspec/core'
require 'rspec/core/rake_task'
require 'active_support/core_ext/string/inflections'
require 'haveapi'
require 'haveapi/tasks/i18n'
require 'haveapi/tasks/yard'

desc 'Check shared documentation required in the server gem'
task :check_doc do
  required = %w[
    doc/protocol.png
    doc/en/readme.md
    doc/en/protocol.md
    doc/en/create-client.md
    doc/en/typed-input-validation.md
    doc/en/client-examples.md
    doc/en/documentation-ui.md
    doc/en/documentation-oauth.md
    doc/en/performance.md
    doc/en/json-schema.html
    doc/cs/readme.md
    doc/cs/protocol.md
    doc/cs/create-client.md
    doc/cs/typed-input-validation.md
    doc/cs/client-examples.md
    doc/cs/json-schema.html
  ]
  missing = required.reject { |path| File.file?(path) && File.size?(path) }

  unless missing.empty?
    abort "Missing or empty shared documentation: #{missing.join(', ')}. " \
          'Run `make doc` from the repository root before building the server gem.'
  end
end

Rake::Task[:build].enhance([:check_doc])

RSpec::Core::RakeTask.new(:spec) do |spec|
  spec.pattern = FileList['spec/**/*_spec.rb']
  spec.rspec_opts = '--require spec_helper'
end

begin
  require 'yard'

  YARD::Rake::YardocTask.new do |t|
    t.files   = ['lib/**/*.rb']
    t.options = [
      '--protected',
      '--output-dir=html_doc',
      '--files=doc/*.md',
      '--files=doc/en/*.md',
      '--files=doc/en/*.html'
    ]
    t.before = proc do
      document_hooks.call
    end
  end
rescue LoadError
  # ignore
end

<% resource_path = path + [resource.to_s] %>
<% key = resource_path.join('.') %>
<li data-resource-item>
  <a href="<%= escape_html(documentation_url(resource: key)) %>" data-resource-link="<%= escape_html(key) %>"<% if @documentation_resource && @documentation_resource[:key] == key %> aria-current="page"<% end %>><%= escape_html(resource.to_s.humanize) %></a>
  <% unless info[:resources].empty? %>
    <ul>
      <% sort_hash(info[:resources]).each do |child, child_info| %>
        <%= erb :'version_sidebar/resource_nav', locals: {resource: child, info: child_info, path: resource_path} %>
      <% end %>
    </ul>
  <% end %>
</li>

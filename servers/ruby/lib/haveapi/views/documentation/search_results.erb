<section data-search-results aria-label="<%= escape_html(documentation_t('search.results')) %>">
  <h2><%= escape_html(documentation_t('search.results_for', query: search[:query])) %></h2>
  <p data-search-status role="status">
    <% if search[:results].empty? %>
      <%= escape_html(documentation_t('browser.search_empty')) %>
    <% elsif search[:more] %>
      <%= escape_html(documentation_t('browser.search_more', count: search[:results].length)) %>
    <% else %>
      <%= escape_html(documentation_t(search[:results].length == 1 ? 'browser.search_one' : 'browser.search_count', count: search[:results].length)) %>
    <% end %>
  </p>
  <ol>
    <% search[:results].each do |result| %>
      <li>
        <a href="<%= escape_html(documentation_search_result_url(result)) %>"><%= escape_html(documentation_t("browser.#{result[:kind]}")) %>: <code><%= escape_html(documentation_search_result_title(result)) %></code></a>
        <% documentation_search_result_context(result).each do |context| %><span><%= escape_html(context) %></span><% end %>
      </li>
    <% end %>
  </ol>
</section>

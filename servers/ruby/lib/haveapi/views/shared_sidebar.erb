<%= erb :'version_sidebar/brand', locals: {account: documentation_account_context} %>
<% if (search_options = documentation_search_form_options(id: 'docs-search-sidebar')) %>
  <%= erb :'documentation/search_form', locals: search_options %>
<% end %>
<nav aria-label="<%= escape_html(documentation_t('accessibility.pages')) %>">
  <ul>
    <li><a href="<%= escape_html(shared_documentation_url) %>"<% if @documentation_page == 'versions' %> aria-current="page"<% end %>><%= escape_html(documentation_t('labels.api_versions')) %></a></li>
    <% if (reference = shared_documentation_reference_url) %>
      <li><a href="<%= escape_html(reference) %>"><%= escape_html(documentation_t('labels.api_reference')) %></a></li>
      <li><a href="<%= escape_html(shared_documentation_reference_url(page: 'resources')) %>"><%= escape_html(documentation_t('labels.resources')) %></a></li>
    <% end %>
  </ul>
</nav>
<% if @documentation_toc && !@documentation_toc.empty? %>
  <nav aria-label="<%= escape_html(documentation_t('labels.contents')) %>" data-action-nav><%= @documentation_toc %></nav>
<% end %>
<nav aria-label="<%= escape_html(documentation_t('accessibility.shared')) %>">
  <h2><a href="<%= escape_html(shared_documentation_url('doc')) %>"><%= escape_html(documentation_t('articles.readme')) %></a></h2>
  <ul>
    <li><a href="<%= escape_html(shared_documentation_url('doc/protocol')) %>"><%= escape_html(documentation_t('articles.protocol')) %></a></li>
    <li><a href="<%= escape_html(shared_documentation_url('doc/json-schema')) %>"><%= escape_html(documentation_t('articles.json_schema')) %></a></li>
    <li><a href="<%= escape_html(shared_documentation_url('doc/create-client')) %>"><%= escape_html(documentation_t('articles.create_client')) %></a></li>
    <li><a href="<%= escape_html(shared_documentation_url('doc/client-examples')) %>"><%= escape_html(documentation_t('articles.client_examples')) %></a></li>
  </ul>
</nav>

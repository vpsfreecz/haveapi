# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

[*.{rb,erb}]
indent_size = 2
indent_style = space

[*.{go,go.erb}]
indent_size = 4
indent_style = tab

[*.php]
indent_size = 4
indent_style = space

[*.plantuml]
indent_size = 2
indent_style = tab

[*.{js,ts,cjs,mjs}]
indent_size = 2
indent_style = space

[*.{rs,rs.erb,py}]
indent_size = 4
indent_style = space

[*.ex]
indent_size = 2
indent_style = space

[Makefile]
trim_trailing_whitespace = false

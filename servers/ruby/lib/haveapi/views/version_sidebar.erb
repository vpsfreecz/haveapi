<%= erb :'version_sidebar/brand', locals: {account: documentation_account_context} %>
<% if (search_options = documentation_search_form_options(id: 'docs-search-sidebar')) %>
  <%= erb :'documentation/search_form', locals: search_options %>
<% end %>
<nav aria-label="<%= escape_html(documentation_t('accessibility.pages')) %>">
  <ul>
    <li><a href="<%= escape_html(documentation_url) %>"<% if @documentation_page == 'overview' %> aria-current="page"<% end %>><%= escape_html(documentation_t('labels.overview')) %></a></li>
    <li>
      <a href="<%= escape_html(documentation_url(page: 'authentication')) %>"<% if @documentation_page == 'authentication' %> aria-current="page"<% end %>><%= escape_html(documentation_t('labels.authentication')) %></a>
      <% if @documentation_page == 'authentication' %>
        <nav aria-label="<%= escape_html(documentation_t('accessibility.authentication_methods')) %>" data-action-nav><%= erb :'version_sidebar/auth_nav', locals: {methods: @help[:authentication]} %></nav>
      <% end %>
    </li>
    <li><a href="<%= escape_html(documentation_url(page: 'resources')) %>"<% if @documentation_page == 'resources' %> aria-current="page"<% end %> data-resource-directory-link><%= escape_html(documentation_t('labels.resources')) %></a></li>
  </ul>
</nav>
<% if @documentation_resource %>
  <p data-current-resource><a href="<%= escape_html(documentation_url(resource: @documentation_resource[:key])) %>"><strong><%= escape_html(@documentation_resource[:key]) %></strong></a></p>
  <nav aria-label="<%= escape_html(documentation_t('accessibility.resource_actions')) %>" data-action-nav>
    <h2><%= escape_html(documentation_t('labels.actions')) %></h2>
    <ul class="docs-action-list">
      <% sort_hash(@documentation_resource[:info][:actions]).each do |action, info| %>
        <% target = documentation_resource_target(resource_path: @documentation_resource[:path], action_name: action) %>
        <li data-doc-nav-owner="<%= escape_html(target) %>">
          <a data-doc-primary href="#<%= escape_html(target) %>"><%= escape_html(action.to_s.humanize) %></a>
          <ul data-doc-subnav="<%= escape_html(target) %>">
            <% documentation_action_sections(info, resource_path: @documentation_resource[:path], action_name: action).each do |section| %>
              <li><a data-doc-subsection href="#<%= escape_html(section[:id]) %>"><%= escape_html(section[:label]) %></a></li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </nav>
  <% unless @documentation_resource[:info][:resources].empty? %>
    <nav aria-label="<%= escape_html(documentation_t('labels.subresources')) %>">
      <h2><%= escape_html(documentation_t('labels.subresources')) %></h2>
      <ul>
        <% sort_hash(@documentation_resource[:info][:resources]).each do |child, _child_info| %>
          <% child_path = @documentation_resource[:path] + [child.to_s] %>
          <li><a href="<%= escape_html(documentation_url(resource: child_path)) %>"><%= escape_html(child_path.join('.')) %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
<% end %>
<% selection = documentation_example_selection %>
<% if selection[:client] %>
<% metadata = documentation_client_metadata %>
<% variants = metadata.select { |entry| entry[:language] == selection[:language] } %>
<% levels = metadata.find { |entry| entry[:id] == selection[:client].id }.fetch(:details) %>
<% detail = documentation_example_detail(levels) %>
<form class="docs-preferences" data-example-preferences method="get" action="<%= escape_html(request.path) %>"<% if selection[:explicit] %> data-example-selection="<%= escape_html(documentation_json(language: selection[:language], client: selection[:client].id, detail:)) %>"<% end %>>
  <% documentation_example_form_parameters.each do |key, value| %>
    <input type="hidden" name="<%= escape_html(key) %>" value="<%= escape_html(value) %>">
  <% end %>
  <label><%= escape_html(documentation_t('labels.programming_language')) %> <select data-language-select name="example_language">
    <% metadata.uniq { |entry| entry[:language] }.each do |entry| %>
      <option value="<%= escape_html(entry[:language]) %>"<% if entry[:language] == selection[:language] %> selected<% end %>><%= escape_html(entry[:language_label]) %></option>
    <% end %>
  </select></label>
  <label data-variant-control><%= escape_html(documentation_t('labels.client')) %> <select data-variant-select name="example_client"<% if variants.length < 2 %> disabled<% end %>>
    <% variants.each do |entry| %>
      <option value="<%= escape_html(entry[:id]) %>"<% if entry[:id] == selection[:client].id %> selected<% end %>><%= escape_html(entry[:variant] || entry[:language_label]) %></option>
    <% end %>
  </select></label>
  <% if variants.length < 2 %><input type="hidden" name="example_client" value="<%= escape_html(selection[:client].id) %>"><% end %>
  <label data-detail-control<% if levels.length < 2 %> hidden<% end %>><%= escape_html(documentation_t('labels.examples')) %> <select data-detail-select name="example_detail"<% if levels.length < 2 %> disabled<% end %>>
    <% levels.each do |level| %><option value="<%= escape_html(level) %>"<% if level == detail %> selected<% end %>><%= escape_html(documentation_t(level == 'thorough' ? 'labels.thorough' : 'labels.simple')) %></option><% end %>
  </select></label>
  <% if levels.length < 2 %><input type="hidden" name="example_detail" value="<%= escape_html(detail) %>"><% end %>
  <button type="submit" data-apply-examples><%= escape_html(documentation_t('labels.apply_examples')) %></button>
  <p data-preference-status role="status"></p>
</form>
<% end %>

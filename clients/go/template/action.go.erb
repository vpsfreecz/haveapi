func (inv *<%= action.go_invocation_type %>) validate() error {
	verr := NewValidationError(inv.Action.Client)
<% if action.has_input? -%>
	if inv.Input != nil {
<% action.input.parameters.each do |p| -%>
<% if %w(Float Datetime Resource).include?(p.type) -%>
		if inv.IsParameterSelected(<%= go_string_literal(p.go_name) %>) {
			if !inv.IsParameterNil(<%= go_string_literal(p.go_name) %>) {
<% if p.type == 'Float' -%>
			if !isFiniteFloat64(inv.Input.<%= p.go_name %>) {
				verr.Add(<%= go_string_literal(p.name) %>, t(inv.Action.Client, "validation.invalid_float", nil))
			}
<% elsif p.type == 'Datetime' -%>
			normalized, ok := normalizeAndCheckDatetimeString(inv.Input.<%= p.go_name %>)
			if !ok {
				verr.Add(<%= go_string_literal(p.name) %>, t(inv.Action.Client, "validation.invalid_datetime", nil))
			} else {
				inv.Input.<%= p.go_name %> = normalized
			}
<% elsif p.type == 'Resource' -%>
			if inv.Input.<%= p.go_name %> < 0 {
				verr.Add(<%= go_string_literal(p.name) %>, t(inv.Action.Client, "validation.invalid_resource_id", nil))
			}
<% end -%>
			}
		}
<% end -%>
<% end -%>
	}
<% end -%>
<% if action.metadata.has_global_input? -%>
	if inv.MetaInput != nil {
<% action.metadata.global.input.parameters.each do |p| -%>
<% if %w(Float Datetime Resource).include?(p.type) -%>
		if inv.IsMetaParameterSelected(<%= go_string_literal(p.go_name) %>) {
			if !inv.IsMetaParameterNil(<%= go_string_literal(p.go_name) %>) {
<% if p.type == 'Float' -%>
			if !isFiniteFloat64(inv.MetaInput.<%= p.go_name %>) {
				verr.Add(<%= go_string_literal(p.name) %>, t(inv.Action.Client, "validation.invalid_float", nil))
			}
<% elsif p.type == 'Datetime' -%>
			normalized, ok := normalizeAndCheckDatetimeString(inv.MetaInput.<%= p.go_name %>)
			if !ok {
				verr.Add(<%= go_string_literal(p.name) %>, t(inv.Action.Client, "validation.invalid_datetime", nil))
			} else {
				inv.MetaInput.<%= p.go_name %> = normalized
			}
<% elsif p.type == 'Resource' -%>
			if inv.MetaInput.<%= p.go_name %> < 0 {
				verr.Add(<%= go_string_literal(p.name) %>, t(inv.Action.Client, "validation.invalid_resource_id", nil))
			}
<% end -%>
			}
		}
<% end -%>
<% end -%>
	}
<% end -%>

	if verr.Empty() {
		return nil
	}

	return verr
}

// Call invokes the action using a background context.
func (inv *<%= action.go_invocation_type %>) Call() (*<%= action.go_response_type %>, error) {
	return inv.CallContext(context.Background())
}

// CallContext invokes the action and decodes its typed response.
func (inv *<%= action.go_invocation_type %>) CallContext(ctx context.Context) (*<%= action.go_response_type %>, error) {
	req, err := inv.newRequest(ctx)
	if err != nil {
		return nil, err
	}
	resp := &<%= action.go_response_type %>{Action: inv.Action}
	raw, err := inv.Action.Client.doRaw(req)
	if err != nil {
		return resp, err
	}
	if err := decodeTypedResponse(raw.Body, resp); err != nil {
		return resp, err
	}
<% if action.has_output? || action.blocking? -%>
	if resp.Status {
		if resp.Response == nil {
			return resp, errMalformedResponse
		}
<% if action.has_output? -%>
		if resp.Response.<%= action.output.go_namespace %> == nil {
			return resp, errMalformedResponse
		}
		resp.Output = resp.Response.<%= action.output.go_namespace %>
<% end -%>
	}
<% end -%>
	return resp, nil
}

// CallRaw validates and sends the action without decoding its response body.
// The caller owns HTTP and API status classification.
func (inv *<%= action.go_invocation_type %>) CallRaw(ctx context.Context) (*RawResponse, error) {
	req, err := inv.newRequest(ctx)
	if err != nil {
		return nil, err
	}
	return inv.Action.Client.doRaw(req)
}

func (inv *<%= action.go_invocation_type %>) newRequest(ctx context.Context) (*http.Request, error) {
	if err := inv.validate(); err != nil {
		return nil, err
	}
<% if action.http_method == 'GET' -%>
	queryParams := make(map[string]string)
<% if action.has_input? -%>
	inv.convertInputToQueryParams(queryParams)
<% end -%>
<% if action.metadata.has_global_input? -%>
	inv.convertMetaInputToQueryParams(queryParams)
<% end -%>
	return inv.Action.Client.newQueryStringRequest(ctx, inv.Path, queryParams)
<% else -%>
<% if action.has_input? || action.metadata.has_global_input? -%>
	input := inv.makeAllInputParams()
<% else -%>
	input := make(map[string]interface{})
<% end -%>
	return inv.Action.Client.newBodyRequest(ctx, <%= go_string_literal(action.http_method) %>, inv.Path, input)
<% end -%>
}

<% if action.blocking? -%>
// IsBlocking checks whether the current invocation resulted in a blocking operation
func (resp *<%= action.go_response_type %>) IsBlocking() bool {
	return resp.Response.Meta != nil && resp.Response.Meta.ActionStateId > 0
}

// OperationStatus queries the current state of the blocking operation
func (resp *<%= action.go_response_type %>) OperationStatus() (*ActionActionStateShowResponse, error) {
	req := resp.Action.Client.ActionState.Show.Prepare()
	req.SetPathParamInt("action_state_id", resp.Response.Meta.ActionStateId)
	return req.Call()
}

// WaitForOperation waits for a blocking operation to finish
func (resp *<%= action.go_response_type %>) WaitForOperation(timeout float64) (*ActionActionStatePollResponse, error) {
	req := resp.Action.Client.ActionState.Poll.Prepare()
	req.SetPathParamInt("action_state_id", resp.Response.Meta.ActionStateId)

	input := req.NewInput()
	input.SetTimeout(timeout)

	return req.Call()
}

// WatchOperation waits for a blocking operation to finish and calls a callback
// function with progress updates
func (resp *<%= action.go_response_type %>) WatchOperation(timeout float64, updateIn float64, callback OperationProgressCallback) (*ActionActionStatePollResponse, error) {
	req := resp.Action.Client.ActionState.Poll.Prepare()
	req.SetPathParamInt("action_state_id", resp.Response.Meta.ActionStateId)

	input := req.NewInput()
	input.SetTimeout(timeout)
	input.SetUpdateIn(updateIn)

	pollResp, err := req.Call()

	if err != nil {
		return pollResp, err
	} else if pollResp.Output.Finished {
		return pollResp, nil
	}

	if callback(pollResp.Output) == StopWatching {
		return pollResp, nil
	}

	for {
		req = resp.Action.Client.ActionState.Poll.Prepare()
		req.SetPathParamInt("action_state_id", resp.Response.Meta.ActionStateId)
		req.SetInput(&ActionActionStatePollInput{
			Timeout: timeout,
			UpdateIn: updateIn,
			Status: pollResp.Output.Status,
			Current: pollResp.Output.Current,
			Total: pollResp.Output.Total,
		})
		pollResp, err = req.Call()

		if err != nil {
			return pollResp, err
		} else if pollResp.Output.Finished {
			return pollResp, nil
		}

		if callback(pollResp.Output) == StopWatching {
			return pollResp, nil
		}
	}
}

// CancelOperation cancels the current blocking operation
func (resp *<%= action.go_response_type %>) CancelOperation() (*ActionActionStateCancelResponse, error) {
	req := resp.Action.Client.ActionState.Cancel.Prepare()
	req.SetPathParamInt("action_state_id", resp.Response.Meta.ActionStateId)
	return req.Call()
}
<% end -%>

<% if action.http_method == 'GET' && action.has_input? -%>
func (inv *<%= action.go_invocation_type %>) convertInputToQueryParams(ret map[string]string) {
	if inv.Input != nil {
	<% action.input.parameters.each do |p| -%>
		if inv.IsParameterSelected(<%= go_string_literal(p.go_name) %>) {
	<% if p.nillable? -%>
			if inv.IsParameterNil(<%= go_string_literal(p.go_name) %>) {
				ret[<%= go_query_key(action.input.namespace, p.name) %>] = ""
			} else {
				ret[<%= go_query_key(action.input.namespace, p.name) %>] = <% if p.go_in_type == 'string' %>inv.Input.<%= p.go_name %><% else %>convert<%= p.go_in_type.capitalize %>ToString(inv.Input.<%= p.go_name %>)<% end %>
			}
	<% else -%>
			ret[<%= go_query_key(action.input.namespace, p.name) %>] = <% if p.go_in_type == 'string' %>inv.Input.<%= p.go_name %><% else %>convert<%= p.go_in_type.capitalize %>ToString(inv.Input.<%= p.go_name %>)<% end %>
	<% end -%>
		}
	<% end -%>
	}
}
<% end -%>

	<% if action.http_method == 'GET' && action.metadata.has_global_input? -%>
	func (inv *<%= action.go_invocation_type %>) convertMetaInputToQueryParams(ret map[string]string) {
		if inv.MetaInput != nil {
	<% action.metadata.global.input.parameters.each do |p| -%>
			if inv.IsMetaParameterSelected(<%= go_string_literal(p.go_name) %>) {
	<% if p.nillable? -%>
				if inv.IsMetaParameterNil(<%= go_string_literal(p.go_name) %>) {
					ret[<%= go_query_key(action.resource.api_version.metadata_namespace, p.name) %>] = ""
				} else {
					ret[<%= go_query_key(action.resource.api_version.metadata_namespace, p.name) %>] = <% if p.go_in_type == 'string' %>inv.MetaInput.<%= p.go_name %><% else %>convert<%= p.go_in_type.capitalize %>ToString(inv.MetaInput.<%= p.go_name %>)<% end %>
				}
	<% else -%>
				ret[<%= go_query_key(action.resource.api_version.metadata_namespace, p.name) %>] = <% if p.go_in_type == 'string' %>inv.MetaInput.<%= p.go_name %><% else %>convert<%= p.go_in_type.capitalize %>ToString(inv.MetaInput.<%= p.go_name %>)<% end %>
	<% end -%>
			}
	<% end -%>
		}
	}
	<% end -%>

<% if action.http_method != 'GET' && (action.has_input? || action.metadata.has_global_input?) -%>
func (inv *<%= action.go_invocation_type %>) makeAllInputParams() *<%= action.go_request_type %> {
	return &<%= action.go_request_type %>{
<% if action.has_input? -%>

<ul class="docs-authentication-submenu">
  <% methods.each do |method, info| %>
    <% target = "auth-#{method}" %>
    <li data-doc-nav-owner="<%= escape_html(target) %>">
      <a data-doc-primary href="#<%= escape_html(target) %>"><%= escape_html(method.to_s.humanize) %></a>
      <ul data-doc-subnav="<%= escape_html(target) %>">
        <% unless (info[:resources] || {}).empty? %>
          <li><a data-doc-subsection href="#<%= escape_html(documentation_reference_anchor(authentication: method, section: :resources)) %>">Resources</a>
            <%= erb :'version_sidebar/auth_resource_nav', locals: {resources: info[:resources], path: [], authentication_provider: method} %>
          </li>
        <% end %>
        <li><a data-doc-subsection href="#<%= escape_html(documentation_reference_anchor(authentication: method, section: :examples)) %>">Examples</a></li>
      </ul>
    </li>
  <% end %>
</ul>

// <%= action.go_type %> is a type for action <%= go_comment_text(action.full_dot_name) %>
type <%= action.go_type %> struct {
	// Pointer to client
	Client *Client
}

func New<%= action.go_type %>(client *Client) *<%= action.go_type %> {

<% if action.has_output? -%>
<% if %w(hash object).include?(action.output.layout) -%>
	// Action output encapsulated within a namespace
	Response *struct {
		<%= action.output.go_namespace %> *<%= action.output.go_type %> <%= go_json_tag(action.output.namespace) %>
<% if action.blocking? -%>

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= escape_html(documentation_document_title) %></title>
  <% if @documentation_ui %>
  <script src="<%= escape_html(url('/js/documentation.js', false)) %>" data-highlighter-url="<%= escape_html(url('/js/highlighter.js', false)) %>"></script>
  <link rel="stylesheet" href="<%= escape_html(url('/css/documentation.css', false)) %>">
  <% else %>

  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <script src="/js/jquery-1.11.1.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/nojs-tabs.js"></script>
  <link rel="stylesheet" href="/css/highlight.css">
  <script src="/js/highlight.pack.js"></script>
  <script src="/js/main.js"></script>

  <style>
    /*.resource { margin-left: 10px; }*/
    /*.resource-body { margin-left: 20px; }*/
    /*.actions { margin-left: 10px; }*/
    .action { margin-left: 10px; }
    .parameters { margin-left: 10px; }

    .table-of-contents {
      position: relative;
    }
    .affix {
      width: inherit;
      height: 100%;
	  position: fixed;
      overflow-y: auto;
    }
    .affix-bottom {
      width: inherit;
      position: absolute;
      top: auto;
      bottom: 200px;
    }
    .affix-top {

    }
    .table-of-contents li.active > a {
      font-weight: bold;
    }
    dl {
      border: 1px solid #ccc;
    }
    dl dt {
      background: #ddd none repeat scroll 0% 0%;
      padding-left: 5px;
    }
    dl dd {
      padding: 5px 0px;
      margin-left: 18px;
    }
    .tab-hidden {
      display: none;
    }
    .nav-tabs {
      display: flex;
      flex-wrap: wrap;
    }
    .nav-tabs > li {
      float: none;
    }
    .nav-tabs a:focus {
      outline: 2px solid #337ab7;
      outline-offset: -2px;
    }
    pre {
      overflow: auto;
    }
    pre code {
      word-wrap: normal;
      white-space: pre;
    }
  </style>
  <% end %>
</head>
<body<% unless @documentation_ui %> data-spy="scroll" data-target=".table-of-contents"<% end %>>
<div class="<%= @documentation_ui ? 'docs-container' : 'container-fluid' %>">
  <%= yield %>

  <footer class="docs-footer">
    <div>
      <p class="text-right">Generated by <a href="https://github.com/vpsfreecz/haveapi">HaveAPI</a> v<%= version %></p>
    </div>
  </footer>
</div>
</body>
</html>

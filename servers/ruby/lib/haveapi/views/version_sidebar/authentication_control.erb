<% controls = account[:controls] %>
<% if controls %>
<div class="authentication">
  <% if account[:user] && controls[:signed_in] %>
    <div class="docs-account-content">
      <span class="sr-only"><%= escape_html(documentation_t('labels.account')) %> </span><span class="docs-identity"><%= escape_html(account[:user].login) %></span>
      <form method="post" action="<%= escape_html(controls[:logout_url]) %>">
        <input type="hidden" name="csrf" value="<%= escape_html(controls[:csrf_token]) %>">
        <button type="submit"><%= escape_html(documentation_t('labels.sign_out')) %></button>
      </form>
      <% if controls[:switch_user] %>
        <form method="post" action="<%= escape_html(controls[:logout_url]) %>">
          <input type="hidden" name="csrf" value="<%= escape_html(controls[:csrf_token]) %>">
          <input type="hidden" name="switch_user" value="1">
          <button type="submit"><%= escape_html(documentation_t('labels.switch_user')) %></button>
        </form>
      <% end %>
    </div>
  <% else %>
    <a class="docs-sign-in" href="<%= escape_html(controls[:login_url]) %>" data-documentation-login aria-label="<%= escape_html(documentation_t('labels.sign_in')) %>" title="<%= escape_html(documentation_t('labels.sign_in')) %>">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21v-2a8 8 0 0 1 16 0v2"></path></svg>
      <span><%= escape_html(documentation_t('labels.sign_in')) %></span>
    </a>
  <% end %>
</div>
<% end %>

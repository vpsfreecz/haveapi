<% if @documentation_page == 'overview' %>
  <h1 id="api">API v<%= escape_html(@v) %></h1>
  <%= erb :'version_page/usage' %>
  <p>Connect to <code><%= escape_html("#{base_url}#{root}") %></code> with a <a href="https://github.com/vpsfreecz/haveapi">HaveAPI client</a>.</p>
  <%= erb :'version_page/client_overview' %>
  <p>Examples target API v<%= escape_html(@v) %>. Generated SDKs use their own package versions and must match this API.</p>
  <section id="initialization" data-doc-section>
    <h2>Initialization</h2>
    <p>Initialize your client, then follow the <a href="<%= escape_html(documentation_url(page: 'authentication')) %>">authentication instructions</a> when credentials are required.</p>
    <%= erb :'version_page/example_panels', locals: {baseid: 'init', kind: :init, changes: {}} %>
  </section>
  <p><a href="<%= escape_html(documentation_url(page: 'resources')) %>" data-resource-directory-link>Browse all resources</a> to find their actions, parameters and examples.</p>
<% elsif @documentation_page == 'resources' %>
  <%= erb :'version_page/resource_directory' %>
<% elsif @documentation_page == 'authentication' %>
  <nav aria-label="Breadcrumb"><ol><li><a href="<%= escape_html(documentation_url) %>">Overview</a></li><li aria-current="page">Authentication</li></ol></nav>
  <h1 id="auth">Authentication</h1>
  <p>Initialize your client using the <a href="<%= escape_html(documentation_url(anchor: 'initialization')) %>">overview examples</a>, then choose an authentication method.</p>
  <% if @help[:authentication].empty? %><p>Authentication is disabled for this API.</p><% end %>
  <% @help[:authentication].each do |name, info| %>
    <%= erb :'version_page/auth_body', locals: {name: name, info: info} %>
  <% end %>
<% else %>
  <% entry = @documentation_resource %>
  <nav aria-label="Breadcrumb" data-resource-breadcrumbs>
    <ol>
      <li><a href="<%= escape_html(documentation_url(page: 'resources')) %>">Resources</a></li>
      <% entry[:path].each_with_index do |part, index| %>
        <% if index == entry[:path].length - 1 %>
          <li aria-current="page"><%= escape_html(part.humanize) %></li>
        <% else %>
          <li><a href="<%= escape_html(documentation_url(resource: entry[:path][0..index])) %>"><%= escape_html(part.humanize) %></a></li>
        <% end %>
      <% end %>
    </ol>
  </nav>
  <%= erb :'version_page/resource_body', locals: {resource: entry[:path].last, info: entry[:info], path: entry[:path][0...-1], prefix: "root#{entry[:path][0...-1].map { |part| "-#{part}" }.join}", name: entry[:label], authentication_resource: false} %>
<% end %>

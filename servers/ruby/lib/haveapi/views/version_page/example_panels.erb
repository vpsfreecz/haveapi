<div class="docs-example" data-example id="<%= escape_html("#{baseid}-examples") %>">
  <% [:simple, :thorough].each do |detail| %>
    <% documentation_panels(kind, **changes, detail: detail).each do |client, result| %>
      <details data-example-panel data-client="<%= escape_html(client.id) %>" data-language="<%= escape_html(client.language) %>" data-variant="<%= escape_html(client.variant) %>" data-detail="<%= detail %>" id="<%= escape_html("#{baseid}-#{client.id}#{detail == :thorough ? '-thorough' : ''}") %>"<% if detail == :simple %> open<% end %>>
        <summary><%= escape_html(client.label) %> · <%= detail == :simple ? 'Simple' : 'With error handling' %></summary>
        <%= erb :'version_page/client_result', locals: {client: client, result: result} %>
      </details>
    <% end %>
  <% end %>
</div>

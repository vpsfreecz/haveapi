<section data-doc-section id="auth-<%= escape_html(name) %>">
<h2><%= escape_html(name.to_s.humanize) %><%= documentation_permalink("auth-#{name}", name.to_s.humanize) %></h2>
<hr>

<p><%= info[:description] %></p>

<% if name == :token %>
  <dl class="docs-metadata">
    <dt>HTTP header:</dt>
    <dd><%= info[:http_header] %></dd>
    <dt>Query parameter:</dt>
    <dd><%= info[:query_parameter] %></dd>
  </dl>
<% elsif name == :oauth2 %>
  <dl class="docs-metadata">
    <dt>Authorize URL:</dt>
    <dd><%= info[:authorize_url] %></dd>
    <dt>Token URL:</dt>
    <dd><%= info[:token_url] %></dd>
    <dt>Revoke URL:</dt>
    <dd><%= info[:revoke_url] %></dd>
  </dl>
<% end %>

<% unless (info[:resources] || {}).empty? %>
  <% resources_target = documentation_reference_anchor(authentication: name, section: :resources) %>
  <h2 id="<%= escape_html(resources_target) %>">Resources<%= documentation_permalink(resources_target, 'Resources') %></h2>
  <% sort_hash(info[:resources]).each do |resource, desc| %>
    <%= erb :"version_page/resource_body", locals: {resource: resource.to_s, info: desc, path: [], prefix: 'root', name: nil, authentication_resource: true, authentication_provider: name} %>
  <% end %>
<% end %>

<% examples_target = documentation_reference_anchor(authentication: name, section: :examples) %>
<h3 id="<%= escape_html(examples_target) %>">Examples<%= documentation_permalink(examples_target, 'Examples') %></h3>
<%= erb :'version_page/example_panels', locals: {baseid: "auth-#{name}", kind: :auth, changes: {auth_method: name, auth_description: info}} %>
</section>

<div class="docs-brand">
  <a href="<%= escape_html(url(root, false)) %>"><%= escape_html(documentation_identity_name) %></a>
  <% if @v %><small class="docs-api-version">API v<%= escape_html(@v) %></small><% end %>
  <details data-documentation-menu>
    <summary aria-label="<%= escape_html(documentation_t('labels.settings')) %>" title="<%= escape_html(documentation_t('labels.settings')) %>">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2"><path d="m9.5 3-.5 2.1-1.7 1-2.1-.6-2.5 4.3 1.6 1.5v2l-1.6 1.5 2.5 4.3 2.1-.6 1.7 1 .5 2.1h5l.5-2.1 1.7-1 2.1.6 2.5-4.3-1.6-1.5v-2l1.6-1.5-2.5-4.3-2.1.6-1.7-1L14.5 3Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
    </summary>
    <div data-documentation-menu-content>
      <form data-documentation-language method="get" action="<%= escape_html(request.path) %>">
        <% documentation_language_parameters.each do |key, value| %>
          <input type="hidden" name="<%= escape_html(key) %>" value="<%= escape_html(value) %>">
        <% end %>
        <label for="docs-language"><%= escape_html(documentation_t('labels.language')) %></label>
        <select id="docs-language" name="doc_lang">
          <option value="en"<% if documentation_locale == 'en' %> selected<% end %>>English</option>
          <option value="cs"<% if documentation_locale == 'cs' %> selected<% end %>>Česky</option>
        </select>
        <button type="submit" data-documentation-language-submit><%= escape_html(documentation_t('labels.apply_language')) %></button>
      </form>
      <span id="docs-theme-label" class="docs-theme-label"><%= escape_html(documentation_t('labels.theme')) %></span>
      <div class="docs-theme-choices" role="group" aria-labelledby="docs-theme-label">
        <% {auto: 'labels.theme_auto', light: 'labels.theme_light', dark: 'labels.theme_dark'}.each do |choice, label| %>
          <button type="button" data-theme-choice="<%= choice %>" aria-label="<%= escape_html(documentation_t(label)) %>" title="<%= escape_html(documentation_t(label)) %>" aria-pressed="<%= choice == :auto %>">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2">
              <% if choice == :auto %><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor"></path>
              <% elsif choice == :light %><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2"></path>
              <% else %><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"></path><% end %>
            </svg>
          </button>
        <% end %>
      </div>
      <% if account %>
        <%= erb :'version_sidebar/authentication_control', locals: {account: account} %>
      <% elsif (account_url = documentation_neutral_account_url) %>
        <a class="docs-account-link" href="<%= escape_html(account_url) %>" aria-label="<%= escape_html(documentation_t('labels.account')) %>" title="<%= escape_html(documentation_t('labels.account')) %>"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21v-2a8 8 0 0 1 16 0v2"></path></svg><span><%= escape_html(documentation_t('labels.account')) %></span></a>
      <% end %>
    </div>
  </details>
  <% if account %>
    <%= erb :'version_sidebar/authentication_status', locals: {account: account} %>
  <% end %>
</div>

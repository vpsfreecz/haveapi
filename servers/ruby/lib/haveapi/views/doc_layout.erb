<% yield %>
<% if @documentation_ui %>
<div data-docs data-page="<%= @documentation_page %>" data-resource="<%= escape_html(@documentation_resource && @documentation_resource[:key]) %>">
  <a class="docs-skip-link" href="#docs-main">Skip to content</a>
  <div class="docs-mobile-toolbar">
    <button type="button" data-nav-toggle aria-controls="docs-navigation" aria-expanded="false">Navigation</button>
  </div>
  <div class="docs-layout">
    <aside class="docs-sidebar" id="docs-navigation" data-docs-sidebar><%= @sidebar %></aside>
    <main class="docs-main" id="docs-main" tabindex="-1"><%= @content %></main>
  </div>
  <script type="application/json" data-documentation-clients><%= documentation_json(@help ? documentation_client_metadata : []) %></script>
  <script type="application/json" data-legacy-anchors><%= documentation_json(@documentation_page == 'overview' ? documentation_legacy_anchors : {}) %></script>
</div>
<% else %>
<div class="row-fluid">
  <div class="col-sm-10">
    <%= @content %>
  </div>

  <div class="col-sm-2 table-of-contents">
    <div class="nav sidebar-nav-fixed" data-spy="affix" data-offset-top="100" data-offset-bottom="200">
      <%= @sidebar %>
    </div>
  </div>
</div>

<script type="text/javascript">
    $(document).ready(function(){

        // Show/hide items in navigation
        $('ul.top-level ul').css('display', 'none');

        $('.table-of-contents').on('activate.bs.scrollspy', function(){
            var j = $(this);

            j.find('ul.top-level ul').css('display', 'none');
            j.find('ul.top-level li.active > ul').css('display', 'block');
        });
    });
</script>

<% end %>

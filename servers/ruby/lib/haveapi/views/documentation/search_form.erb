<form data-documentation-search method="get" action="<%= escape_html(action) %>" data-search-version="<%= escape_html(version) %>" data-search-index-url="<%= escape_html(index_url) %>" data-search-view-key="<%= escape_html(view_key) %>">
  <input type="hidden" name="page" value="resources">
  <input type="hidden" name="doc_lang" value="<%= escape_html(documentation_locale) %>">
  <label for="<%= escape_html(id) %>-query"><%= escape_html(documentation_t('search.label', version: version)) %></label>
  <input type="search" name="q" data-search-query id="<%= escape_html(id) %>-query" value="<%= escape_html(query) %>" placeholder="<%= escape_html(documentation_t('search.placeholder')) %>" maxlength="256">
  <button type="submit"><%= escape_html(documentation_t('search.submit')) %></button>
  <div data-search-suggestions role="region" aria-label="<%= escape_html(documentation_t('search.suggestions')) %>" hidden>
    <p data-search-status role="status"></p>
    <div data-search-preview></div>
  </div>
</form>
